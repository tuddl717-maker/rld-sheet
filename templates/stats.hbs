<section class='tab rld-paper {{ tab.cssClass }}' data-tab='{{ tab.id }}' data-group='{{ tab.group }}'>
  <div class='rld-sec'>
    <img class='rose' src='modules/rld-sheet/assets/rose.webp' alt='' /><h2>능력치</h2><span class='ln'></span><img class='vine' src='modules/rld-sheet/assets/div_mid.webp' alt='' />
  </div>
  <div class='rld-grid3'>
    {{#each sortedAttributes as |type key|}}
      <div class='rld-col'>
        <div class='rld-colhead'><img src='{{rldColIcon key}}' alt='' />{{rldColLabel key}}</div>
        {{#each type as |attribute|}}
          <div class='rld-row attribute'>
            <label class='rld-nm resource-label rollable' data-action='roll' data-value-paths='attributes.{{ attribute.id }}.value' data-select-dialog='true' data-attribute='{{ attribute.id }}'>{{ attribute.displayName }}</label>
            <div class='resource-value' data-value='{{ attribute.value }}' data-name='system.attributes.{{ attribute.id }}.value'>
              <span class='resource-value-empty' data-action='dotCounterEmpty'></span>
              {{#numLoop 5}}<span class='resource-value-step' data-action='dotCounterChange' data-index='{{ this }}'></span>{{/numLoop}}
            </div>
          </div>
        {{/each}}
      </div>
    {{/each}}
  </div>

  <div class='rld-sec'>
    <img class='rose' src='modules/rld-sheet/assets/rose.webp' alt='' /><h2>기술</h2><span class='ln'></span><img class='vine' src='modules/rld-sheet/assets/div_mid.webp' alt='' />
  </div>
  <div class='rld-grid3'>
    {{#each sortedSkills as |type key|}}
      <div class='rld-col'>
        <div class='rld-colhead'><img src='{{rldColIcon key}}' alt='' />{{rldColLabel key}}</div>
        {{#each type as |skill|}}
          <div class='rld-row skill'>
            <div class='rld-nm resource-label'>
              <a class='edit-skill' data-action='editSkill' title='전문 분야·설정' data-skill='{{ skill.id }}'><i class='fas fa-feather'></i></a>
              <label class='rollable' data-action='roll' data-value-paths='skills.{{ skill.id }}.value' data-skill='{{ skill.id }}' data-select-dialog='true' data-use-flavor-path='true' data-flavor-path='skills.{{ skill.id }}.description' data-macroid='{{ skill.macroid }}'>{{ skill.displayName }}</label>
              {{#if skill.specialtiesList.length}}
                <span class='rld-spec' title='{{#each skill.specialtiesList as |b|}}{{ b }}{{#unless @last}}, {{/unless}}{{/each}}'>{{#each skill.specialtiesList as |b|}}{{ b }}{{#unless @last}}, {{/unless}}{{/each}}</span>
              {{/if}}
            </div>
            <div class='resource-value' data-value='{{ skill.value }}' data-name='system.skills.{{ skill.id }}.value'>
              <span class='resource-value-empty' data-action='dotCounterEmpty'></span>
              {{#numLoop 5}}<span class='resource-value-step' data-action='dotCounterChange' data-index='{{ this }}'></span>{{/numLoop}}
            </div>
          </div>
        {{/each}}
      </div>
    {{/each}}
  </div>
  <p class='rld-hint'>능력치나 기술 이름을 누르면 주사위 풀을 고르는 창이 떠요.</p>

  <div class='rld-two'>
    <div>
      <div class='rld-sec small'><img class='rose' src='modules/rld-sheet/assets/rosebud.webp' alt='' /><h2>상태</h2><span class='ln'></span></div>
      <div class='rld-box items-list flexcol'>
        {{#each conditions as |condition id|}}
          <div class='item flexrow {{#if condition.system.suppressed}}suppressed{{/if}}' data-drag='true' data-item-id='{{ condition.id }}' data-document-uuid='{{ condition.uuid }}' data-type='Item'>
            <div class='item-image clickable' data-action='itemChat' data-item-id='{{ condition._id }}'><img src='{{ condition.img }}' width='22' height='22' alt='' /></div>
            <div class='item-name'>{{ condition.name }}</div>
            <div class='item-controls'>
              <a class='item-control' data-action='itemOpen' data-item-id='{{ condition._id }}'><i class='fas fa-edit'></i></a>
              <a class='item-control' data-action='toggleConditionSuppression' data-item-id='{{ condition._id }}'><i class='fa-solid {{#if condition.system.suppressed}}fa-toggle-off{{else}}fa-toggle-on{{/if}}'></i></a>
              <a class='item-control' data-action='itemDelete' data-item-id='{{ condition._id }}'><i class='fas fa-trash'></i></a>
            </div>
          </div>
        {{else}}
          <div class='rld-empty'>없음</div>
        {{/each}}
        <div class='rld-add'>
          <a class='item-control' data-action='searchItem' data-type='condition' title='검색'><i class='fa-solid fa-magnifying-glass'></i></a>
          <a class='item-control' data-action='createItem' data-type='condition' title='추가'><i class='fas fa-plus'></i></a>
        </div>
      </div>
    </div>
    <div>
      <div class='rld-sec small'><img class='rose' src='modules/rld-sheet/assets/rosebud.webp' alt='' /><h2>자주 쓰는 굴림</h2><span class='ln'></span></div>
      <div class='rld-box items-list flexcol'>
        {{#each customRolls as |roll id|}}
          <div class='item flexrow' data-drag='true' data-item-id='{{ roll.id }}' data-document-uuid='{{ roll.uuid }}' data-type='Item'>
            <div class='item-image rollable-item' data-action='rollItem' data-item-uuid='{{ roll.uuid }}'><img src='{{ roll.img }}' width='22' height='22' alt='' /></div>
            <div class='item-name'>{{ roll.name }}</div>
            <div class='item-controls'>
              <a class='item-control' data-action='itemOpen' data-item-id='{{ roll._id }}'><i class='fas fa-edit'></i></a>
              <a class='item-control' data-action='itemDelete' data-item-id='{{ roll._id }}'><i class='fas fa-trash'></i></a>
            </div>
          </div>
        {{else}}
          <div class='rld-empty'>없음</div>
        {{/each}}
        <div class='rld-add'>
          <a class='item-control' data-action='createItem' data-type='customRoll' title='추가'><i class='fas fa-plus'></i></a>
        </div>
      </div>
    </div>
  </div>
</section>
